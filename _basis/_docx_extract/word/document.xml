83" w:rsidR="00C82EB5" w:rsidRDefault="00182002" w:rsidP="009F1675"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t xml:space="preserve">Med unntak av </w:t></w:r><w:r w:rsidR="00C82EB5"><w:t>FartObj_</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00C82EB5"><w:t>ID  og</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00C82EB5"><w:t xml:space="preserve"> FartSpes_</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00C82EB5"><w:t>ID</w:t></w:r><w:r><w:t>,</w:t></w:r><w:r w:rsidR="00C82EB5"><w:t xml:space="preserve">  vises</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00C82EB5"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t>verdiene i feltene som arvet</w:t></w:r><w:r w:rsidR="00C82EB5"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="37220D8B" w14:textId="77777777" w:rsidR="009F1675" w:rsidRDefault="00C82EB5" w:rsidP="009F1675"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>For at lagringsknappen skal bli «enabled» må minst ett av feltene være endret.</w:t></w:r><w:r w:rsidR="00182002"><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="07A54118" w14:textId="3428436A" w:rsidR="00AF5A5F" w:rsidRDefault="00AF5A5F" w:rsidP="009F1675"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>Nå</w:t></w:r><w:r w:rsidR="00182002"><w:t>r lagringsknappen er trykket</w:t></w:r><w:r w:rsidR="00C82EB5"><w:t xml:space="preserve"> skal det oppstå en ny rad i tblfartspes</w:t></w:r><w:r><w:t xml:space="preserve"> som inneholder verdiene i feltene</w:t></w:r><w:r w:rsidR="00C82EB5"><w:t>. Den nye radens</w:t></w:r><w:r><w:t xml:space="preserve"> auto-genererte</w:t></w:r><w:r w:rsidR="00C82EB5"><w:t xml:space="preserve"> FartSpes</w:t></w:r><w:r w:rsidR="00182002"><w:t>_</w:t></w:r><w:r w:rsidR="00C82EB5"><w:t>ID</w:t></w:r><w:r w:rsidR="00182002"><w:t xml:space="preserve"> og den eksisterende FartObj_ID brukes til å produsere en ny rad i tblfarttid som arver alle data fra det valgte fartøyets rad i tblfarttid, med ny FartSpesID, YearTid og YearMnd fra den nye raden i tblfartspes.</w:t></w:r><w:r w:rsidR="008E0AAC"><w:t xml:space="preserve"> Eierskifte settes = False og Navning settes = False.</w:t></w:r></w:p><w:p w14:paraId="33109878" w14:textId="07872F73" w:rsidR="00AB260C" w:rsidRDefault="00AF5A5F" w:rsidP="009F1675"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>Deretter åpnes feltene i den nye raden av tblfarttid for eventuelle endringe</w:t></w:r><w:r w:rsidR="00AB260C"><w:t>r</w:t></w:r><w:r w:rsidR="00D35FCE"><w:t xml:space="preserve"> i en egen container under tblfartspes sin,</w:t></w:r><w:r w:rsidR="008E0AAC"><w:t xml:space="preserve"> med en «disabled» lagringsknapp nederst</w:t></w:r><w:r w:rsidR="00D35FCE"><w:t xml:space="preserve"> i containeren</w:t></w:r><w:r w:rsidR="008E0AAC"><w:t xml:space="preserve">. For at lagringsknappen skal bli «enabled» må minst ett av feltene være endret. Hvis Rederi </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="008E0AAC"><w:t>endres</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="004E62C9"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="008E0AAC"><w:t xml:space="preserve">skal Eierskifte settes = True. Hvis FartNavn endres skal Navning settes = True. </w:t></w:r></w:p><w:p w14:paraId="107EEBD8" w14:textId="6B95B96E" w:rsidR="004E62C9" w:rsidRDefault="004E62C9" w:rsidP="009F1675"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>FartType_ID, FartsObj_ID og FartSpes_ID kan ikke endres.</w:t></w:r></w:p><w:p w14:paraId="6A3C47EA" w14:textId="47445E34" w:rsidR="008E0AAC" w:rsidRDefault="008E0AAC" w:rsidP="003F417C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>Etter lagring er trykket returneres</w:t></w:r><w:r w:rsidR="004E62C9"><w:t xml:space="preserve"> til /admin/fart_admin.php.</w:t></w:r></w:p><w:p w14:paraId="42567220" w14:textId="77777777" w:rsidR="009F1675" w:rsidRDefault="00AB260C" w:rsidP="003F417C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>Hvis ‘Andre endringer’-knappen trykkes</w:t></w:r><w:r w:rsidR="009F1675"><w:t>:</w:t></w:r></w:p><w:p w14:paraId="28698CE4" w14:textId="1BEAFD9E" w:rsidR="00D35FCE" w:rsidRDefault="00D35FCE" w:rsidP="00D35FCE"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>Øverst vises en container med ikke-redigerbare verdier fra det valgte fartøyets tblfartobj. Under denne containeren vises en tabell over alle rader i tblfart</w:t></w:r><w:r w:rsidR="00202EEE"><w:t>tid som har det valgte fartøyets FartObj_ID. Tabellen skal inneholde konkatinert YearTid&amp;’/’MndTid, konkatinert FartType&amp;’ ‘&amp;FartNavn, Reghavn, Nasjon.</w:t></w:r></w:p><w:p w14:paraId="0BEE6585" w14:textId="77777777" w:rsidR="00202EEE" w:rsidRDefault="009F1675" w:rsidP="003F417C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>F</w:t></w:r><w:r w:rsidR="00AB260C"><w:t xml:space="preserve">eltene for tblfarttid </w:t></w:r><w:r><w:t xml:space="preserve">vises </w:t></w:r><w:r w:rsidR="00AB260C"><w:t>for det fartøyet</w:t></w:r><w:r w:rsidR="004E62C9"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="003F417C"><w:t xml:space="preserve">som ble </w:t></w:r><w:r w:rsidR="004E62C9"><w:t>valgt</w:t></w:r><w:r w:rsidR="00AB260C"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="008E0AAC"><w:t xml:space="preserve">først </w:t></w:r><w:r w:rsidR="00AB260C"><w:t xml:space="preserve">i </w:t></w:r><w:r w:rsidR="008E0AAC"><w:t>/admin/fart_edit.php</w:t></w:r><w:r w:rsidR="004E62C9"><w:t>. Feltene vises</w:t></w:r><w:r w:rsidR="00AB260C"><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00D35FCE"><w:t xml:space="preserve">i egen container </w:t></w:r><w:r w:rsidR="00AB260C"><w:t>med en «disabled» lagringsknapp nederst.</w:t></w:r></w:p><w:p w14:paraId="0D5E99EB" w14:textId="7B732EA1" w:rsidR="00AB260C" w:rsidRDefault="00202EEE" w:rsidP="00202EEE"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>Verdier til kontaineren kan også hentes fra tabellen, der hver rad må ha en valg-knapp og kunne velges ved mouse-down.</w:t></w:r><w:r w:rsidR="00AB260C"><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="715AE3B4" w14:textId="77777777" w:rsidR="00961A2D" w:rsidRDefault="004E62C9" w:rsidP="003F417C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t xml:space="preserve">For at lagringsknappen skal bli «enabled» må minst ett av feltene være endret. </w:t></w:r></w:p><w:p w14:paraId="655344D6" w14:textId="030D60BC" w:rsidR="00961A2D" w:rsidRDefault="004E62C9" w:rsidP="003F417C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="6"/></w:numPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:t>Hvis FartNavn, Rederi, Kallesignal</w:t></w:r><w:r w:rsidR="00202EEE"><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00202EEE"><w:t>eller</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r w:r